# Copia questo file in ".env" e adatta i valori al tuo ambiente (XAMPP: utente root, password vuota).
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=concerto_db

# Chiave con cui vengono firmati i token JWT: usane una lunga e casuale.
JWT_SECRET=cambia-questa-chiave-con-una-stringa-lunga-e-casuale

# Opzionali (valori predefiniti tra parentesi)
# JWT_EXPIRES_IN=24h
# SOGLIA_PRIMI_ISCRITTI=5
# MAX_BIGLIETTI_PER_UTENTE=4
# CLIENT_ORIGIN=http://localhost:5173
